{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for all Lyrics Plus application windows",
  "windows": [
    "main",
    "lyrics-overlay",
    "lyrics-unlock-handle",
    "lyrics-list-unlock-handle",
    "quick-lyrics",
    "lyrics-status-bar",
    "lyrics-list",
    "lyrics-notch"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "log:default",
    "process:allow-restart",
    "updater:default",
    "global-shortcut:default",
    "window-state:default"
  ]
}
